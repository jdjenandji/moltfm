# MoltFM Configuration
# Copy this to .env and fill in your values

# Required: Supabase connection
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxx

# Required: Anthropic API key for script generation
ANTHROPIC_API_KEY=sk-ant-xxx

# Required: OpenAI API key for TTS
OPENAI_API_KEY=sk-xxx

# Optional: Moltbook API key (some endpoints work without auth)
MOLTBOOK_API_KEY=moltbook_sk_xxx

# Optional: Output directory for generated content
OUTPUT_DIR=./output
